# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
packages/*/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Cloudflare/OpenNext build and local runtime state
/.open-next/
/.thally-upload/
/.wrangler/
/src/generated/runtime-sources.ts
/src/generated/runtime-docs.ts
/src/generated/runtime-docs/
/public/_thally/content/

# production
/build

# misc
.DS_Store
*.pem
.data/

# thally generated artifacts (embeddings cache, analytics)
.thally/
# legacy pre-rebrand cache dir — keep ignored so stale local caches never commit
.dox/
.data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.next
.out
# Workspace package build output — generated by `packages:build` (which the app's
# prebuild runs) and by `prepublishOnly` at npm-publish time, so it needn't be committed.
packages/*/dist

# Local agent/tooling state + scratch — not part of the product, never committed.
.claude/
.agents/
skills-lock.json
CLAUDE.md

# Local demo scaffolds (other projects generated for testing).
demo/

# Local planning notes are never part of the published repository.
notes/
